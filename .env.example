# Copy to .env for docker compose. NEVER commit the real .env.
POSTGRES_PASSWORD=change-me-locally
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional AI model for the assistant.
# Docker Compose reads these from this ROOT .env and passes them to the backend.
# Supported providers: none (default/evidence-only) or anthropic. OpenRouter is not implemented.
# Keep LLM_API_KEY secret; never expose it to the frontend or commit a real .env.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional Google sign-in (leave blank to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
