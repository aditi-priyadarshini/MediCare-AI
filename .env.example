# Copy to .env for docker compose. NEVER commit the real .env.
POSTGRES_PASSWORD=change-me-locally
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Scan to fill (camera / upload on Records and Lab results). Reads reports on this server with
# Tesseract; no document or text is sent to any other service. Set SCAN_ENABLED=false to switch off.
SCAN_ENABLED=true
# Add languages only after installing their packs (see backend/Dockerfile), e.g. eng+hin+ori
OCR_LANGUAGES=eng
# Optional AI models for the assistant. Leave LLM_PROVIDER=none for evidence-only mode.
# LLM_PROVIDER is an ORDERED chain: the first that answers is used, the next is tried if it fails.
#   LLM_PROVIDER=gemini,nvidia,openrouter
# Built-in names: anthropic, gemini, nvidia, openrouter, openai, groq (any others: LLM_CUSTOM_PROVIDERS).
# Each name needs <NAME>_API_KEY and <NAME>_MODEL. Use model names your account can access.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_BASE_URL=http://localhost:8000/v1   # your own NIM container instead of the hosted API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENAI_API_KEY=
GROQ_API_KEY=
# Anthropic (legacy names kept): LLM_API_KEY / LLM_MODEL
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Any other OpenAI-compatible server (Ollama, vLLM, Together...), as one line of JSON:
# LLM_CUSTOM_PROVIDERS=[{"name":"local","base_url":"http://localhost:11434/v1","model":"llama3.1"}]
# Optional Google sign-in (leave blank to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
