# Backend settings (see app/core/config.py). Real values go in .env, never in Git.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://medicare:medicare@localhost:5432/medicare
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FRONTEND_ORIGINS=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
# --- Zoho Mail SMTP (production). Use the host for YOUR Zoho data centre:
#   smtp.zoho.com (US) | smtp.zoho.in (India) | smtp.zoho.eu (EU) | smtp.zoho.com.au | smtp.zoho.jp
# Port 465 + SMTP_SECURITY=ssl  (or port 587 + SMTP_SECURITY=starttls)
# SMTP_USERNAME is the full Zoho mailbox; SMTP_PASSWORD is an APP PASSWORD if 2FA is on
# (Zoho Accounts > Security > App Passwords). SMTP_FROM must be that mailbox (or one of its aliases).
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USERNAME=no-reply@yourdomain.com
# SMTP_PASSWORD=
# SMTP_FROM=MediCare AI <no-reply@yourdomain.com>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Production only: COOKIE_SECURE=true, a unique SECRET_KEY (EMAIL_BACKEND=memory is rejected)
# AI assistant. Default "none": the assistant lists matching records without an AI model.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# ASSISTANT_REQUESTS_PER_MINUTE=20
# Uploaded records (PDF/PNG/JPEG). Mount a persistent volume here in production.
# STORAGE_DIR=./storage
# MAX_UPLOAD_BYTES=10485760
# Reminder calls over WebRTC (off by default; see docs/REMINDER_CALLS.md)
# CALLS_ENABLED=true
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349?transport=tcp
# Same value as coturn's static-auth-secret:
# TURN_SECRET=
# TTS_COMMAND=piper --model /models/en_US-lessac-medium.onnx --output_file {out}
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/run/call-secrets/fcm-service-account.json
# APNS_KEY_FILE=/run/call-secrets/AuthKey_example.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=org.example.medicare
# CALL_RING_SECONDS=45
# CALL_MAX_ATTEMPTS=2
