# Backend settings (see app/core/config.py). Real values go in .env, never in Git.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://medicare:medicare@localhost:5432/medicare
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FRONTEND_ORIGINS=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Production only: COOKIE_SECURE=true, a unique SECRET_KEY (EMAIL_BACKEND=memory is rejected)
# Uploaded records (PDF/PNG/JPEG). Mount a persistent volume here in production.
# STORAGE_DIR=./storage
# MAX_UPLOAD_BYTES=10485760
